# =============================================================================
# KNIGHT — .gitignore
# =============================================================================

# Terraform / Terragrunt
**/.terraform/*
.terraform.lock.hcl
.terragrunt-cache/
**/.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Sensitive variable files
*.tfvars
*.tfvars.json
!example.tfvars

# Local env / credentials
.env
*.pem
